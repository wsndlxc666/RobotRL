index 0000000..6b2525d
--- /dev/null
+++ b/rlinf/models/embodiment/reward/robometer_reward_model.py
@@ -0,0 +1,212 @@
+# Copyright 2026 The RLinf Authors.
+"""Robometer (Qwen3-VL-4B PRM) as an RLinf reward model.
+
+Wraps the frozen Robometer progress head and turns per-frame progress into a
+window-level dense reward: r = (p_t - p_{t-1}) / window_len.  The env worker's
+``history_buffer`` machinery broadcasts this scalar over the scoring window, so
+every env step gets non-zero credit instead of only the terminal success.
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+import sys
+from types import SimpleNamespace
+from typing import Any
+
+import numpy as np
+import torch
+from omegaconf import DictConfig, OmegaConf
+
+from rlinf.models.embodiment.reward.base_reward_model import BaseRewardModel
+
+
+class RobometerRewardModel(BaseRewardModel):
+    def __init__(self, cfg: DictConfig):
+        super().__init__(cfg)
+        self.model_path = str(cfg.get("model_path"))
+        self.base_model_id = str(
+            cfg.get("base_model_id", "Qwen/Qwen3-VL-4B-Instruct")
+        )
+        self.repo_path = str(
+            cfg.get("robometer_repo", "/root/autodl-tmp/code/robometer")
+        )
+        self.max_frames = int(cfg.get("max_frames", 8))
+        self.min_frames = int(cfg.get("min_frames", 4))
+        self.reward_clip = float(cfg.get("reward_clip", 0.2))
+        self.reward_scale = float(cfg.get("reward_scale", 1.0))
+        self.default_task = str(cfg.get("default_task", "Open the drawer."))
+        precision = str(cfg.get("precision", "bf16")).lower()
+        self.dtype = torch.bfloat16 if precision in {"bf16", "bfloat16"} else torch.float16
+        self.num_envs = int(cfg.get("num_envs", 1))
+        self.register_buffer("_prev_progress", torch.zeros(self.num_envs))
+        self.register_buffer("_seen", torch.zeros(self.num_envs, dtype=torch.bool))
+        self.setup_model()
+
+    # ------------------------------------------------------------------
+    def setup_model(self) -> None:
+        if self.repo_path not in sys.path:
+            sys.path.insert(0, self.repo_path)
+        from robometer.data.collators import RBMBatchCollator
+        from robometer.data.dataset_types import ProgressSample, Trajectory
+        from robometer.models.rbm import RBM
+        from robometer.models.utils import convert_bins_to_continuous
+        from safetensors.torch import load_file
+        from transformers import AutoConfig, AutoProcessor
+
+        cfg_yaml = OmegaConf.load(os.path.join(self.model_path, "config.yaml"))
+        mc = SimpleNamespace(
+            average_temporal_patches=cfg_yaml.model.average_temporal_patches,
+            use_per_frame_progress_token=cfg_yaml.data.use_per_frame_progress_token,
+            use_multi_image=cfg_yaml.data.use_multi_image,
+            frame_pooling=cfg_yaml.model.get("frame_pooling", "mean"),
+            frame_pooling_attn_temperature=cfg_yaml.model.get(
+                "frame_pooling_attn_temperature", 1.0
+            ),
+            progress_loss_type=cfg_yaml.loss.progress_loss_type,
+            progress_discrete_bins=cfg_yaml.loss.progress_discrete_bins,
+        )
+
+        os.environ.setdefault("HF_ENDPOINT", "https://hf-mirror.com")
+        processor = AutoProcessor.from_pretrained(
+            self.base_model_id, trust_remote_code=True
+        )
+        for tok in (
+            "<|split_token|>",
+            "<|reward_token|>",
+            "<|pref_token|>",
+            "<|sim_token|>",
+            "<|prog_token|>",
+        ):
+            if tok not in processor.tokenizer.get_vocab():
+                processor.tokenizer.add_special_tokens(
+                    {"additional_special_tokens": [tok]}
+                )
+        if processor.tokenizer.pad_token is None:
+            processor.tokenizer.pad_token = processor.tokenizer.eos_token
+
+        config = AutoConfig.from_pretrained(self.model_path)
+        config._attn_implementation = "sdpa"
+        model = RBM(
+            config,
+            processor,
+            processor.tokenizer,
+            base_model_id=self.base_model_id,
+            model_config=mc,
+        )
+        state = {}
+        for shard in sorted(glob.glob(os.path.join(self.model_path, "model-*.safetensors"))):
+            state.update(load_file(shard))
+        missing, unexpected = model.load_state_dict(state, strict=False)
+        if missing:
+            raise RuntimeError(f"Robometer missing weights: {missing[:5]} ({len(missing)})")
+        del state
+        self._model = model.to(dtype=self.dtype).eval()
+        self.processor = processor
+        self.tokenizer = processor.tokenizer
+        self._collator = RBMBatchCollator(
+            processor,
+            processor.tokenizer,
+            max_length=1024,
+            base_model_id=self.base_model_id,
+            use_multi_image=True,
+            prog_pref=False,
+            use_per_frame_progress_token=True,
+            inference=True,
+        )
+        self._ProgressSample = ProgressSample
+        self._Trajectory = Trajectory
+        self._convert_bins = convert_bins_to_continuous
+        print(
+            f"[robometer] loaded {self.model_path} (missing=0, unexpected={len(unexpected)})",
+            flush=True,
+        )
+
+    # ------------------------------------------------------------------
+    def forward(self, input_data: torch.Tensor, labels=None) -> dict[str, Any]:
+        raise NotImplementedError("RobometerRewardModel is inference-only")
+
+    def _frames_from_history(self, history_input: dict) -> list:
+        for buffer in history_input.values():
+            for key, per_env in buffer.items():
+                if key in {"main_images", "rgb", "images"}:
+                    return per_env
+        # fall back to the first buffer regardless of key
+        for buffer in history_input.values():
+            for per_env in buffer.values():
+                return per_env
+        return []
+
+    def _as_uint8(self, x) -> np.ndarray:
+        if torch.is_tensor(x):
+            x = x.detach().cpu().numpy()
+        arr = np.asarray(x)
+        if arr.dtype != np.uint8:
+            if arr.max() <= 1.0:
+                arr = (arr * 255.0).clip(0, 255)
+            arr = arr.clip(0, 255).astype(np.uint8)
+        return arr
+
+    @torch.no_grad()
+    def compute_reward(self, observations: dict[str, Any]) -> torch.Tensor:
+        history_input = observations.get("history_input", {}) or {}
+        frames_per_env = self._frames_from_history(history_input)
+        rewards = torch.zeros(self.num_envs, dtype=torch.float32)
+        if not frames_per_env:
+            return rewards
+
+        tasks = observations.get("task_descriptions", None)
+        dones = observations.get("dones", None)
+
+        indices, samples = [], []
+        for env_id, frames in enumerate(frames_per_env):
+            if frames is None or len(frames) < self.min_frames:
+                continue
+            arr = np.stack([self._as_uint8(f) for f in frames])
+            if len(arr) > self.max_frames:
+                pick = np.linspace(0, len(arr) - 1, self.max_frames).astype(int)
+                arr = arr[pick]
+            task = self.default_task
+            if tasks is not None:
+                try:
+                    t = tasks[env_id]
+                    if isinstance(t, str):
+                        task = t
+                except Exception:
+                    pass
+            traj = self._Trajectory(
+                frames=arr,
+                frames_shape=tuple(arr.shape),
+                task=task,
+                id=str(env_id),
+                metadata={"subsequence_length": int(arr.shape[0])},
+            )
+            samples.append(self._ProgressSample(trajectory=traj, sample_type="progress"))
+            indices.append(env_id)
+
+        if samples:
+            batch = self._collator(samples)["progress_inputs"]
+            device = self._prev_progress.device
+            batch = {
+                k: (v.to(device) if hasattr(v, "to") else v) for k, v in batch.items()
+            }
+            output, _ = self._model(**batch, sample_type="progress")
+            progress = output.progress_logits["A"].detach().cpu().float()
+            # Discrete head returns [S, T, num_bins]; continuous returns [S, T].
+            if progress.dim() == 3:
+                progress = self._convert_bins(progress)
+            last = progress[:, -1]
+            for j, env_id in enumerate(indices):
+                prev = float(self._prev_progress[env_id].item())
+                delta = float(last[j].item()) - prev
+                delta = max(-self.reward_clip, min(self.reward_clip, delta))
+                window = max(len(frames_per_env[env_id]), 1)
+                rewards[env_id] = delta * self.reward_scale / window
+                self._prev_progress[env_id] = last[j].item()
+
+        if dones is not None:
+            for env_id, done in enumerate(dones.detach().cpu().flatten().tolist()):
+                if done:
+                    self._prev_progress[env_id] = 0.0
+        return rewards
